# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  beeja.md — model configuration                                              ║
# ║                                                                              ║
# ║  1. cp .env.example .env        (make setup does this for you)               ║
# ║  2. fill in the four values in STEP 1 below                                  ║
# ║  3. beeja extract -i <discussion file> -o out/decision.json                  ║
# ║                                                                              ║
# ║  .env is git-ignored. Never commit real keys. Real environment variables     ║
# ║  always win over values in this file.                                        ║
# ╚══════════════════════════════════════════════════════════════════════════════╝
#
# Only `beeja extract` talks to a model. search / get / why-not / check-diff /
# benchmark / the web viewer / the MCP server work with no model at all.
#
# ─── HACKATHON RULE ──────────────────────────────────────────────────────────────
# The project declares qwen3:4b on a local Ollama server (HACKATHON.md) and every
# committed example was produced by it. The participant guidelines allow
# open-weight models "on your laptop or on our model server"; closed model APIs
# score 0 for Open-Source AI Use. If you use something else for the submission,
# update HACKATHON.md and re-run examples/ with it.

# ═══ STEP 1 · which model ═════════════════════════════════════════════════════════

# Provider. One of:
#   ollama             local / organiser Ollama server (default, no key needed)
#   ollama-cloud       Ollama Cloud (https://ollama.com), needs BEEJA_API_KEY
#   openai-compatible  ANY OpenAI-style server: vLLM, llama.cpp, LM Studio,
#                      LiteLLM, an organiser endpoint ... (set BEEJA_BASE_URL)
#   replay             no model: replay a recorded run (set BEEJA_REPLAY_FILE)
#   (run `beeja providers` to list every built-in preset and its default model)
BEEJA_PROVIDER=ollama

# Model name exactly as the provider expects it.
#   ollama:            qwen3:4b · gemma4:31b-cloud (via `ollama signin`) · ...
#   openai-compatible: whatever the server serves, e.g. Qwen/Qwen3-4B
BEEJA_MODEL=qwen3:4b

# Server URL. Leave empty for the provider default.
#   ollama default:    http://localhost:11434   (a bare host like `my-box` means port 11434)
#   openai-compatible: the URL ending in /v1, e.g. http://10.0.0.5:8000/v1
BEEJA_BASE_URL=

# API key, only if the server needs one. Only ever sent to non-local hosts.
BEEJA_API_KEY=

# ═══ STEP 2 · tuning (optional) ═══════════════════════════════════════════════════

# Context window requested from Ollama. 8 GB laptop swapping? use 4096 together
# with `beeja extract --chunk-chars 4000`.
BEEJA_NUM_CTX=8192

# Seconds to wait for one model call before retrying.
BEEJA_TIMEOUT=600

# Put the JSON schema into the prompt as well. `auto` turns it on for hosted
# endpoints, which ignore Ollama's grammar-constrained `format` (1 = always, 0 = never).
BEEJA_SCHEMA_IN_PROMPT=auto

# ═══ STEP 3 · offline replay (optional) ═══════════════════════════════════════════

# With BEEJA_PROVIDER=replay, re-run extraction from a recorded real run, no model:
# BEEJA_REPLAY_FILE=examples/pep-0758/model_exchanges.jsonl

# ═══ Other tools ══════════════════════════════════════════════════════════════════

# Decision store read by the MCP server (beeja-mcp).
BEEJA_STORE=decisions

# Terminal colours: NO_COLOR=1 turns them off, FORCE_COLOR=1 forces them on.
# NO_COLOR=1
